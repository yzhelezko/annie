---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import Icon from '../components/Icon.astro';
import { load } from '../lib/data';
import { cvPdfUrl, span } from '../lib/cv';
import { phoneHref, phoneLabel, type Ctx } from '../lib/i18n';

interface Props {
  ctx: Ctx;
}
const { ctx } = Astro.props;
const { site, cv, about } = await load();
const name = ctx.t(site.name);
const pdf = cvPdfUrl(cv, ctx, site);
const home = Astro.site ? new URL(ctx.href(), Astro.site).href.replace(/^https?:\/\//, '').replace(/\/$/, '') : undefined;
const skills = cv.skills.length ? cv.skills : about.services;
---
<Base ctx={ctx} title={ctx.ui('cv.title')}>
  <div class="page">
    <p class="actions">
      <a class="slip ink" href={pdf.url} download={pdf.name}><Icon name="download" size={16} />{ctx.ui('cv.download')}</a>
      <button class="slip" type="button" onclick="print()">{ctx.ui('cv.print')}</button>
    </p>

    <article class="sheet">
      <header class="band">
        <Band class="marble" seed={name} colors={site.theme.pigments} />
        <div class="id">
          <h1>{name}</h1>
          <p class="role">{ctx.t(site.role)}</p>
        </div>
      </header>

      <ul class="contacts">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.phone && <li class="tnum"><a href={phoneHref(site.phone)}>{phoneLabel(site.phone)}</a></li>}
        {site.location && <li>{ctx.t(site.location)}</li>}
        {home && <li><a href={ctx.href()}>{home}</a></li>}
        {site.socials.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
      </ul>

      <div class="cols">
        <div class="main">
          {cv.summary && <p class="summary">{ctx.t(cv.summary)}</p>}

          {
            cv.experience.length > 0 && (
              <section>
                <h2>{ctx.ui('cv.experience')}</h2>
                <ol class="entries">
                  {cv.experience.map((e) => (
                    <li>
                      <p class="when tnum">{span(e, ctx)}</p>
                      <div>
                        <h3>{ctx.t(e.role)}</h3>
                        <p class="org">{e.company}{e.place && ` · ${ctx.t(e.place)}`}</p>
                        {e.text && <p class="desc">{ctx.t(e.text)}</p>}
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          {
            cv.education.length > 0 && (
              <section>
                <h2>{ctx.ui('cv.education')}</h2>
                <ol class="entries">
                  {cv.education.map((e) => (
                    <li>
                      <p class="when tnum">{span(e, ctx)}</p>
                      <div>
                        <h3>{ctx.t(e.title)}</h3>
                        <p class="org">{e.place}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          {
            cv.awards.length > 0 && (
              <section>
                <h2>{ctx.ui('cv.awards')}</h2>
                <ol class="entries">
                  {cv.awards.map((a) => (
                    <li>
                      <p class="when tnum">{a.year}</p>
                      <div>
                        <h3>{ctx.t(a.title)}</h3>
                        {a.place && <p class="org">{a.place}</p>}
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }
        </div>

        <aside class="side">
          {
            skills.length > 0 && (
              <section>
                <h2>{ctx.ui('cv.skills')}</h2>
                <ul class="list">{skills.map((s) => <li>{ctx.t(s)}</li>)}</ul>
              </section>
            )
          }
          {
            cv.tools.length > 0 && (
              <section>
                <h2>{ctx.ui('cv.tools')}</h2>
                <ul class="pills">{cv.tools.map((s) => <li>{s}</li>)}</ul>
              </section>
            )
          }
          {
            cv.languages.length > 0 && (
              <section>
                <h2>{ctx.ui('cv.languages')}</h2>
                <ul class="list">{cv.languages.map((s) => <li>{ctx.t(s)}</li>)}</ul>
              </section>
            )
          }
        </aside>
      </div>
    </article>
  </div>
</Base>

<style>
  .page {
    padding: 96px var(--gutter) var(--space-1);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
    margin-bottom: 20px;
  }
  .ink {
    background: var(--ink);
    color: var(--paper);
  }
  .actions .slip:not(.ink) {
    background: transparent;
    border: 1.5px solid var(--ink);
  }
  .actions .slip:not(.ink):hover {
    background: var(--ink);
  }

  .sheet {
    --pad: clamp(20px, 5vw, 56px);
    max-width: 920px;
    margin-inline: auto;
    background: var(--paper);
    color: var(--ink);
    border: 1.5px solid var(--ink);
  }
  .band {
    position: relative;
    aspect-ratio: 1000 / 260;
    min-height: 200px;
    display: flex;
    align-items: flex-end;
    color: var(--paper);
    overflow: hidden;
  }
  .band :global(.marble) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .id {
    position: relative;
    padding: var(--pad);
    padding-bottom: calc(var(--pad) * 0.7);
  }
  h1 {
    font-size: clamp(2.2rem, 1rem + 5vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }
  .role {
    display: inline-block;
    margin-top: 12px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 600;
    font-size: var(--step--1);
    padding: 0.45em 0.7em;
  }
  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    padding: 18px var(--pad);
    border-bottom: 1.5px solid var(--ink);
    font-size: var(--step--1);
    font-weight: 560;
  }
  .contacts a {
    text-decoration: none;
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
    gap: clamp(24px, 4vw, 48px);
    padding: var(--pad);
  }
  .summary {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 36px;
  }
  section + section {
    margin-top: 32px;
  }
  h2 {
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.02em;
    padding-bottom: 8px;
    margin-bottom: 4px;
    border-bottom: 1.5px solid var(--ink);
  }
  .entries li {
    display: grid;
    grid-template-columns: 8.5em 1fr;
    gap: 16px;
    padding-block: 14px;
    break-inside: avoid;
  }
  .entries li + li {
    border-top: 1px solid var(--hair);
  }
  .when {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
    padding-top: 0.2em;
  }
  h3 {
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .org {
    font-weight: 560;
  }
  .desc {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .list li {
    padding-block: 8px;
    font-size: var(--step--1);
    font-weight: 560;
    border-bottom: 1px solid var(--hair);
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 10px;
  }
  .pills li {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.3em 0.7em;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
  }
  @media (max-width: 720px) {
    .cols {
      grid-template-columns: 1fr;
    }
    .entries li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  @page {
    size: A4;
    margin: 14mm 0 14mm;
  }
  @page :first {
    margin-top: 0;
  }
  @media print {
    :global(.nav),
    :global(.foot),
    :global(.skip),
    .actions {
      display: none !important;
    }
    :global(body) {
      background: #fff;
      font-size: 9.5pt;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
    .page {
      padding: 0;
    }
    .sheet {
      --pad: 14mm;
      max-width: none;
      border: 0;
      background: #fff;
    }
    .band {
      aspect-ratio: auto;
      height: 62mm;
      min-height: 0;
    }
    h1 {
      font-size: 34pt;
    }
    .role,
    .contacts,
    .when,
    .desc,
    .list li {
      font-size: 8.5pt;
    }
    .summary {
      font-size: 12pt;
      margin-bottom: 7mm;
    }
    h3 {
      font-size: 10pt;
    }
    h2 {
      font-size: 8pt;
    }
    .cols {
      grid-template-columns: 1fr 52mm;
      gap: 10mm;
      padding-top: 8mm;
    }
    .entries li {
      grid-template-columns: 26mm 1fr;
      padding-block: 3mm;
    }
    .pills li {
      font-size: 7.5pt;
    }
  }
</style>
