---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import Icon from '../components/Icon.astro';
import { load } from '../lib/data';
import { makeCtx } from '../lib/i18n';

const { site, ui } = await load();
const ctx = makeCtx(site.languages[0].code, '404/', site.languages, ui);
---
<Base ctx={ctx} title={ctx.ui('notFound.title')}>
  <section class="sank">
    <Band class="marble" seed="404" colors={site.theme.pigments} width={1000} height={620} />
    <div class="inner wrap">
      <h1>{ctx.ui('notFound.title')}</h1>
      <p class="slip">{ctx.ui('notFound.text')}</p>
      <ul class="langs">
        {ctx.langs.map((l) => <li><a class="slip" href={ctx.href('', l.code)} lang={l.code}><Icon name="back" size={16} />{l.name}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .sank {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    color: var(--paper);
    overflow: hidden;
    isolation: isolate;
  }
  .sank :global(.marble) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
  .inner {
    padding-block: 120px 56px;
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.92;
    max-width: 10ch;
    margin-bottom: 24px;
  }
  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }
</style>
