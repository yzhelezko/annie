---
import Icon from './Icon.astro';
import { load } from '../lib/data';
import { cvPdfUrl, span } from '../lib/cv';
import type { Ctx } from '../lib/i18n';

interface Props {
  ctx: Ctx;
}
const { ctx } = Astro.props;
const { cv, site } = await load();
const pdf = cvPdfUrl(cv, ctx, site);
---
<section class="cvs wrap" id="cv" aria-labelledby="cv-h">
  <header class="sec-head">
    <h2 id="cv-h">{ctx.ui('cv.experience')}</h2>
    <p class="actions">
      <a class="slip ink" href={ctx.href('cv/')}>{ctx.ui('cv.full')}<Icon name="arrow" size={16} /></a>
      <a class="slip ink" href={pdf.url} download={pdf.name}><Icon name="download" size={16} />PDF</a>
    </p>
  </header>
  <ol class="rows">
    {
      cv.experience.map((e) => (
        <li>
          <span class="when tnum">{span(e, ctx)}</span>
          <span class="what">{ctx.t(e.role)}</span>
          <span class="where">{e.company}{e.place && `, ${ctx.t(e.place)}`}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .cvs {
    padding-bottom: var(--space-1);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .rows li {
    display: grid;
    grid-template-columns: minmax(9ch, 2fr) 5fr 4fr;
    gap: 6px var(--gap);
    align-items: baseline;
    padding-block: 18px;
    border-top: 1.5px solid var(--ink);
  }
  .rows li:last-child {
    border-bottom: 1.5px solid var(--ink);
  }
  .when {
    font-weight: 560;
    color: var(--ink-2);
  }
  .what {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 650;
    letter-spacing: -0.025em;
  }
  .where {
    color: var(--ink-2);
  }
  @media (max-width: 700px) {
    .rows li {
      grid-template-columns: 1fr;
    }
  }
</style>
