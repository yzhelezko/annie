---
import Icon from './Icon.astro';
import { load } from '../lib/data';
import type { Ctx } from '../lib/i18n';

interface Props {
  ctx: Ctx;
}
const { ctx } = Astro.props;
const { site } = await load();
const home = ctx.href();
const links = [
  { label: ctx.ui('nav.work'), href: `${home}#work` },
  { label: ctx.ui('nav.about'), href: `${home}#about` },
  { label: ctx.ui('nav.cv'), href: ctx.href('cv/') },
  { label: ctx.ui('nav.contact'), href: `${home}#contact` },
];
const current = (href: string) => href === ctx.href(ctx.path);
---
<header class="nav">
  <a class="slip mark" href={home} aria-label={ctx.ui('nav.home')}>{ctx.t(site.name)}</a>
  <nav class="slip links" aria-label={ctx.ui('nav.menu')}>
    {links.map((l) => <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a>)}
  </nav>
  <ul class="slip langs" aria-label={ctx.ui('nav.language')}>
    {
      ctx.langs.map((l) => (
        <li>
          <a href={ctx.href(ctx.path, l.code)} hreflang={l.code} lang={l.code} title={l.name} aria-current={l.code === ctx.lang ? 'true' : undefined}>
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
  <button class="slip menu-btn" popovertarget="menu" aria-haspopup="dialog">
    {ctx.ui('nav.menu')}<Icon name="menu" size={16} />
  </button>
  <div id="menu" popover class="menu" role="dialog" aria-label={ctx.ui('nav.menu')}>
    <button class="slip close" popovertarget="menu" popovertargetaction="hide">
      {ctx.ui('nav.close')}<Icon name="close" size={16} />
    </button>
    <ul class="menu-links">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <ul class="menu-langs">
      {
        ctx.langs.map((l) => (
          <li>
            <a class="slip" href={ctx.href(ctx.path, l.code)} hreflang={l.code} lang={l.code} aria-current={l.code === ctx.lang ? 'true' : undefined}>
              {l.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .nav {
    view-transition-name: nav;
    position: fixed;
    inset: 12px var(--gutter) auto;
    z-index: 50;
    display: flex;
    align-items: flex-start;
    gap: 6px;
    pointer-events: none;
  }
  .nav > * {
    pointer-events: auto;
  }
  .mark {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .links {
    gap: 0;
    padding: 0;
  }
  .links a,
  .langs a {
    display: block;
    padding: 0.6em 0.8em;
    text-decoration: none;
  }
  .links a:hover,
  .langs a:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .links a[aria-current],
  .langs a[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .langs {
    margin-left: auto;
    padding: 0;
    gap: 0;
  }
  .menu-btn,
  .close {
    display: none;
  }

  .menu {
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding: 72px var(--gutter) 32px;
    background: var(--p1);
    color: var(--paper);
    flex-direction: column;
    justify-content: space-between;
  }
  .menu:popover-open {
    display: flex;
  }
  .menu::backdrop {
    background: transparent;
  }
  .menu .close {
    position: absolute;
    top: 12px;
    right: var(--gutter);
    display: inline-flex;
  }
  .menu-links a {
    display: block;
    font-family: var(--font-display);
    font-weight: 760;
    font-size: clamp(2.4rem, 11vw, 4.5rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
    text-decoration: none;
  }
  .menu-langs {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .menu-langs a[aria-current] {
    background: var(--ink);
    color: var(--paper);
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu:popover-open {
      animation: menu-drop 520ms var(--ease-spread) both;
    }
  }
  @keyframes menu-drop {
    from {
      clip-path: circle(0 at calc(100% - 48px) 30px);
    }
    to {
      clip-path: circle(150vmax at calc(100% - 48px) 30px);
    }
  }

  @media (max-width: 760px) {
    .links,
    .langs {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
      margin-left: auto;
    }
  }
</style>
