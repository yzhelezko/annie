---
import Icon from './Icon.astro';
import { load } from '../lib/data';
import type { Ctx } from '../lib/i18n';

interface Props {
  ctx: Ctx;
}
const { ctx } = Astro.props;
const { site } = await load();
---
<section class="contact" id="contact" aria-labelledby="contact-h" style={`--base:${site.theme.pigments[1] ?? site.theme.pigments[0]}`}>
  <canvas class="print" data-lifted-print aria-hidden="true"></canvas>
  <div class="inner wrap">
    <h2 id="contact-h">{ctx.ui('contact.title')}</h2>
    <a class="mail" href={`mailto:${site.email}`} style={`--len:${site.email.length}`}>{site.email}</a>
    <p class="row">
      <a class="slip" href={`mailto:${site.email}`}><Icon name="arrow" size={16} />{ctx.ui('contact.write')}</a>
      <button class="slip" type="button" data-copy={site.email} data-done={ctx.ui('contact.copied')}>
        <Icon name="copy" size={16} /><span class="label">{ctx.ui('contact.copy')}</span>
      </button>
      {
        site.socials.map((s) => (
          <a class="slip" href={s.url} rel="me noopener" target="_blank">
            {s.label}
            <Icon name="external" size={14} />
          </a>
        ))
      }
    </p>
  </div>
</section>

<style>
  .contact {
    position: relative;
    min-height: min(92svh, 900px);
    display: flex;
    align-items: flex-end;
    background: var(--base);
    color: var(--paper);
    overflow: hidden;
    isolation: isolate;
  }
  .print {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    clip-path: circle(0 at 50% 100%);
  }
  .print:global(.inked) {
    clip-path: circle(150% at 50% 100%);
    transition: clip-path 1400ms var(--ease-spread);
  }
  .inner {
    padding-block: var(--space-2) clamp(40px, 6vw, 80px);
  }
  h2 {
    font-size: var(--step-3);
    max-width: 14ch;
  }
  .mail {
    display: inline-block;
    margin-top: clamp(20px, 3vw, 40px);
    font-family: var(--font-display);
    font-weight: 800;
    /* sized so the whole address fits one line: Unbounded averages ~0.8em per glyph */
    font-size: min(6rem, calc((100vw - 2 * var(--gutter)) / (var(--len) * 0.8)));
    letter-spacing: -0.045em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .mail:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: clamp(28px, 4vw, 48px);
  }
  @media (prefers-reduced-motion: reduce) {
    .print:global(.inked) {
      transition: none;
    }
  }
</style>
