---
import Icon from './Icon.astro';
import { load } from '../lib/data';
import { phoneHref, phoneLabel, type Ctx } from '../lib/i18n';

interface Props {
  ctx: Ctx;
}
const { ctx } = Astro.props;
const { site } = await load();
const name = ctx.t(site.name);
---
<section class="contact wrap" id="contact" aria-labelledby="contact-h">
  <figure class="sheet">
    <div class="print" style={`--base:${site.theme.pigments[1] ?? site.theme.pigments[0]}`}>
      <canvas data-lifted-print aria-hidden="true"></canvas>
      <div class="on">
        <h2 id="contact-h">{ctx.ui('contact.title')}</h2>
        <a class="mail" href={`mailto:${site.email}`} style={`--len:${site.email.length}`}>{site.email}</a>
      </div>
    </div>
    <figcaption class="seal"><span data-seal>{name} · {new Date().getFullYear()}</span></figcaption>
  </figure>
  <p class="row">
    <a class="slip ink" href={`mailto:${site.email}`}><Icon name="arrow" size={16} />{ctx.ui('contact.write')}</a>
    <button class="slip ink" type="button" data-copy={site.email} data-done={ctx.ui('contact.copied')}>
      <Icon name="copy" size={16} /><span class="label">{ctx.ui('contact.copy')}</span>
    </button>
    {site.phone && <a class="slip ink tnum" href={phoneHref(site.phone)}>{phoneLabel(site.phone)}</a>}
    {
      site.socials.map((s) => (
        <a class="slip ink" href={s.url} rel="me noopener" target="_blank">
          {s.label}
          <Icon name="external" size={14} />
        </a>
      ))
    }
  </p>
</section>

<style>
  .contact {
    padding-block: var(--space-1) clamp(40px, 6vw, 72px);
  }
  /* the close is a print lifted from the hero bath: pigment on a fresh sheet, margin and seal */
  .sheet {
    --sheet: color-mix(in srgb, var(--paper) 35%, #fff);
    background: var(--sheet);
    padding: clamp(10px, 1.6vw, 22px) clamp(10px, 1.6vw, 22px) 0;
    outline: 1px solid var(--hair);
    rotate: -0.6deg;
  }
  .print {
    position: relative;
    min-height: min(78svh, 760px);
    display: flex;
    align-items: flex-end;
    background: var(--base);
    color: var(--paper);
    overflow: hidden;
    isolation: isolate;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    clip-path: circle(0 at 50% 100%);
  }
  canvas:global(.inked) {
    clip-path: circle(150% at 50% 100%);
    transition: clip-path 1400ms var(--ease-spread);
  }
  .on {
    padding: clamp(28px, 5vw, 72px) clamp(18px, 3vw, 48px);
  }
  h2 {
    font-size: var(--step-3);
    max-width: 14ch;
  }
  .mail {
    --room: calc(100vw - 2 * var(--gutter) - 2 * clamp(10px, 1.6vw, 22px) - 2 * clamp(18px, 3vw, 48px));
    display: inline-block;
    margin-top: clamp(20px, 3vw, 40px);
    font-family: var(--font-display);
    font-weight: 800;
    /* sized so the whole address fits one line: Unbounded averages ~0.8em per glyph */
    font-size: min(5.5rem, calc(min(var(--room), var(--max) - 200px) / (var(--len) * 0.8)));
    letter-spacing: -0.045em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .mail:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
  }
  .seal {
    display: flex;
    justify-content: flex-end;
    padding-block: 10px 12px;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: clamp(24px, 3vw, 36px);
  }
  @media (prefers-reduced-motion: reduce) {
    canvas:global(.inked) {
      transition: none;
    }
  }
</style>
