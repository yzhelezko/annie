---
import Media from './Media.astro';
import Edge from './Edge.astro';
import { load } from '../lib/data';
import { resolve } from '../lib/media';
import type { Ctx } from '../lib/i18n';

interface Props {
  ctx: Ctx;
}
const { ctx } = Astro.props;
const { about, site } = await load();
const ink = site.theme.pigments[0];
const portrait = about.portrait ? resolve(about.portrait, 'content/media', 'about.yaml → portrait') : undefined;
const [lead, ...rest] = about.bio.map(ctx.t);
const clients = about.clients.map((c) => (typeof c === 'string' ? { name: c, url: undefined } : c));
---
<section class="about" id="about" aria-labelledby="about-h">
  <div class="field reveal" aria-hidden="true">
    <Edge seed="about-top" color={ink} paper={site.theme.paper} />
    <div class="body"></div>
    <Edge seed="about-bottom" color={ink} paper={site.theme.paper} flip />
  </div>
  <div class="inner wrap">
    <h2 id="about-h">{ctx.ui('about.title')}</h2>
    <div class="text">
      {lead && <p class="lead">{lead}</p>}
      {rest.map((p) => <p>{p}</p>)}
    </div>
    {
      portrait && (
        <figure class="portrait">
          <Media ctx={ctx} res={portrait} alt={ctx.t(about.portraitAlt)} ratio="4/5" sizes="(min-width: 900px) 30vw, 80vw" />
        </figure>
      )
    }
    {
      about.services.length > 0 && (
        <div class="services">
          <h3 class="slip">{ctx.ui('about.services')}</h3>
          <ul>
            {about.services.map((s) => <li class="slip">{ctx.t(s)}</li>)}
          </ul>
        </div>
      )
    }
    {
      clients.length > 0 && (
        <div class="clients">
          <h3 class="slip">{ctx.ui('about.clients')}</h3>
          <ul>
            {clients.map((c) => <li class="slip">{c.url ? <a href={c.url}>{c.name}</a> : c.name}</li>)}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .about {
    position: relative;
    color: var(--paper);
    isolation: isolate;
  }
  /* one drop of pigment spreads to become the section's ground; its edge is a real ink contour */
  .field {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: flex;
    flex-direction: column;
    --ox: 12%;
    --oy: 0%;
  }
  .body {
    flex: 1;
    background: var(--p1);
  }
  .inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 64px) var(--gap);
    padding-block: calc(clamp(56px, 9vw, 150px) + var(--space-1) * 0.4) calc(clamp(56px, 9vw, 150px) + var(--space-1));
  }
  h2 {
    grid-column: 1 / -1;
    font-size: var(--step-3);
  }
  .text {
    grid-column: 1 / span 7;
    display: grid;
    gap: 0.9em;
    max-width: 62ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .lead {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.025em;
  }
  .portrait {
    grid-column: 9 / span 4;
    grid-row: 2 / span 2;
    align-self: start;
  }
  .services,
  .clients {
    grid-column: 1 / span 7;
  }
  h3 {
    font-family: var(--font-text);
    letter-spacing: 0;
    margin-bottom: 6px;
  }
  .services ul,
  .clients ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .services li,
  .clients li {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  @media (max-width: 900px) {
    .text,
    .services,
    .clients {
      grid-column: 1 / -1;
    }
    .portrait {
      grid-column: 1 / span 9;
      grid-row: auto;
    }
  }
</style>
